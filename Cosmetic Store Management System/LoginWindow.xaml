<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cosmetic_Store_Management_System.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Activated="Window_Activated">

    <StackPanel Orientation="Vertical" 
        HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="LOGIN" 
                   FontSize="40" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,15"
                   x:Uid="LoginWindow_Login"/>
        <TextBox Header="Enter your username:" 
                 Name="usernameTextBox"
                 x:Uid="LoginWindow_Username"/>
        <PasswordBox Name="passwordBox" 
                     Header="Enter password"
                     x:Uid="LoginWindow_Password"/>
        <CheckBox Name="rememberCheckBox" 
                  Content="Remember me"
                  x:Uid="LoginWindow_RememberMeCheckBox"/>
        <Button x:Name="loginButton" 
                Click="loginButton_Click" 
                HorizontalAlignment="Center"
                Content="Login"
                x:Uid="LoginWindow_LoginButton"/>
    </StackPanel>
</Window>
