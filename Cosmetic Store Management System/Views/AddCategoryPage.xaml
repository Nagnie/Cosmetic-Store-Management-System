<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cosmetic_Store_Management_System.Views.AddCategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Name"
                   Grid.Row="1"
                   Grid.Column="0"
                   Margin="0, 0, 0, 12"
                   x:Uid="AddCategoryPage_Name"/>
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Margin="0, 0, 0, 12"
                 Text="{x:Bind ViewModel.Category.Name, Mode=TwoWay}"/>

        <TextBlock Text="Description"
                   Grid.Column="0"
                   Grid.Row="2"
                   x:Uid="AddCategoryPage_Description"/>
        <TextBox Grid.Column="1"
                 Grid.Row="2"
                 ScrollViewer.HorizontalScrollMode="Enabled"
                 TextWrapping="Wrap"
                 Height="120"
                 Text="{x:Bind ViewModel.Category.productCount, Mode=TwoWay}"/>

        <StackPanel Grid.Column="1"
                Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0, 16, 0, 0">
            <Button Content="Save"
                    Width="80"
                    Margin="0, 0, 12, 0"
                    Click="saveButton_Click"
                    x:Uid="AddCategoryPage_SaveButton"/>
            <Button Content="Cancel"
                    Width="80"
                    Click="cancelButton_Click"
                    x:Uid="AddCategoryPage_CancelButton"/>
        </StackPanel>
    </Grid>
</Page>
