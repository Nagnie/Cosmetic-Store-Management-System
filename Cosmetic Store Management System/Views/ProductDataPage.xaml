<Page
    x:Class="Cosmetic_Store_Management_System.Views.ProductDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:Cosmetic_Store_Management_System.Core.Models"
    xmlns:views="using:Cosmetic_Store_Management_System.Views"
    xmlns:behaviors="using:Cosmetic_Store_Management_System.Behaviors" 
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Template cho các sản phẩm -->
        <DataTemplate x:Key="ProductItemTemplate" x:DataType="models:Cosmetic">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="500" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ID, Mode=OneWay}" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Left" 
                        Click="OnProductClick" 
                        Background="Transparent" 
                        BorderBrush="Transparent" 
                        Margin="0, 0, 20, 0">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"  VerticalAlignment="Center" HorizontalAlignment="Left" />
                </Button>
                <TextBlock Text="{x:Bind Quantity}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock Text="{x:Bind Price, Mode=OneWay}" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="{x:Bind Category.Name, Mode=OneWay}" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="{x:Bind Manufacturer.Name, Mode=OneWay}" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="ContentArea">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,30,0,0">
                    <TextBlock Text="Products" FontSize="24" FontWeight="Bold" HorizontalTextAlignment="Left" />
                    <Button 
                        Content="Add New"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="100,0,0,10"
                        FontSize="16"
                        Background="Transparent"
                        MinHeight="40"
                        MinWidth="120"
                        Click="AddNewButton_Click">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border                             
                                                BorderBrush="Gray"
                                                BorderThickness="2"
                                                CornerRadius="5">
                                                <!-- Đặt CornerRadius để bo tròn -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <SymbolIcon Symbol="Add"  Margin="0,0,7,0" />
                                                    <ContentPresenter 
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Phần danh sách các sản phẩm -->
                <StackPanel>
                    <!-- Tiêu đề cột -->
                    <Grid Height="40" 
                          Background="{StaticResource SmokeFillColorDefaultBrush}" 
                          Margin="0, 20, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="500" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ID" Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center" HorizontalTextAlignment="Center"/>
                        <TextBlock Text="Name" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center" HorizontalTextAlignment="Left" Margin="27,0,0,0"/>
                        <TextBlock Text="Quantity" Grid.Column="2" FontWeight="Bold" VerticalAlignment="Center" HorizontalTextAlignment="Left" Margin="15,0,0,0"/>
                        <TextBlock Text="Price" Grid.Column="3" FontWeight="Bold" VerticalAlignment="Center" HorizontalTextAlignment="Left" Margin="15,0,0,0"/>
                        <TextBlock Text="Category" Grid.Column="4" FontWeight="Bold" VerticalAlignment="Center" HorizontalTextAlignment="Left" Margin="15,0,0,0"/>
                        <TextBlock Text="Manufacturer" Grid.Column="5" FontWeight="Bold" VerticalAlignment="Center" HorizontalTextAlignment="Left" Margin="15,0,0,0"/>
                    </Grid>

                    <!-- Danh sách sản phẩm -->
                    <ListView
                        x:Uid="ProductList"
                        x:Name="ProductListView"
                        ItemsSource="{x:Bind ViewModel.Cosmetics, Mode=OneWay}"
                        ItemTemplate="{StaticResource ProductItemTemplate}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>