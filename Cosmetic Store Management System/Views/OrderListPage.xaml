<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cosmetic_Store_Management_System.Views.OrderListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="using:Cosmetic_Store_Management_System.Behaviors"
    xmlns:local="using:Cosmetic_Store_Management_System.Helpers"
    xmlns:local2="using:Cosmetic_Store_Management_System.Core.Models"
    xmlns:local3="using:Cosmetic_Store_Management_System.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <local:IntToCurrencyConverter x:Key="currencyConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bộ lọc -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="10">
                <AutoSuggestBox x:Name="SearchBox"
                                x:Uid="OrderListPage_SearchBox"
                                Width="300"
                                PlaceholderText="Search by name or phone"
                                QueryIcon="Find" 
                                Margin="5"/>
                <Button 
                    Style="{StaticResource AccentButtonStyle}"
                    Background="{StaticResource AccentFillColorTertiaryBrush}"
                    Content="Search" Click="SearchButton_Click" Width="100" Margin="5"
                    x:Uid="OrderListPage_SearchButton"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"  VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Start Date:" VerticalAlignment="Center" Margin="5" x:Uid="OrderListPage_StartDate"/>
                <DatePicker x:Name="StartDatePicker"  
                            Margin="0,0,5,0" />

                <TextBlock Text="End Date:" VerticalAlignment="Center" Margin="5" x:Uid="OrderListPage_EndDate"/>
                <DatePicker x:Name="EndDatePicker"
                            Margin="0,0,5,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Background="{StaticResource AccentFillColorTertiaryBrush}"
                    Content="Filter" Click="FilterButton_Click" Width="100" Margin="5" 
                    x:Uid="OrderListPage_FilterButton"/>
                <Button 
                    Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                    Style="{StaticResource AccentButtonStyle}"
                    Background="{ThemeResource AccentAcrylicBackgroundFillColorBaseBrush}"
                    Content="Clear Filter" 
                    Click="ClearFilterButton_Click"
                    Width="100" 
                    Margin="5" 
                    x:Uid="OrderListPage_ClearFilterButton"/>
            </StackPanel>
        </StackPanel>
        


        <!-- GridView to display order summaries -->
        <GridView
            x:Name="OrderGridView"
            Grid.Row="2"
            Margin="10"
            ItemsSource="{x:Bind ViewModel.Orders}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="OrderGridView_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local2:Order">
                    <StackPanel CornerRadius="12" 
                        Width="300" 
                        Height="160" 
                        Padding="16, 16, 16, 16"
                        BorderBrush="{StaticResource AccentFillColorTertiaryBrush}"
                        BorderThickness="1">    
                        <StackPanel>
                            <TextBlock Text="{x:Bind ID}" FontSize="18" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Order Time:" FontWeight="Bold" x:Uid="OrderListPage_OrderTime"/>
                                <TextBlock Text="{x:Bind OrderTime}" FontSize="14" Foreground="Gray" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total:" FontWeight="Bold" x:Uid="OrderListPage_Total"/>
                                <TextBlock Text="{x:Bind Total, Converter={StaticResource currencyConverter}}" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Customer's Name:" FontWeight="Bold" x:Uid="OrderListPage_CusName"/>
                                <TextBlock Text="{x:Bind Customer.Name}" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Customer's Phone:" FontWeight="Bold" x:Uid="OrderListPage_CusPhone"/>
                                <TextBlock Text="{x:Bind Customer.Phone}" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>

            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="12, 12, 12, 12"/>
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>


        <!-- Pagination controls -->
        <StackPanel 
            Grid.Row="3" 
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Bottom" 
            Margin="10">
            
            <TextBlock Name="infoTextBlock" 
                Text="{x:Bind ViewModel.Info, Mode=OneWay}" 
                Margin="0,10,5,0"/>

            <Button 
                Margin="5" 
                Height="35" 
                Name="previousButton" 
                Click="previousButton_Click"
                IsEnabled="{x:Bind ViewModel.EnablePrev, Mode=OneWay}">
                <FontIcon Glyph="&#xE973;" />
            </Button>
            
            <ComboBox ItemsSource="{x:Bind ViewModel.PageInfos, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.CurrentPageInfo, Mode=TwoWay}"
                SelectionChanged="pagesComboBox_SelectionChanged"
                Margin="5" Name="pagesComboBox" Width="80" Height="35">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Page}"/>/<Run Text="{Binding Total}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
            <Button Name="nextButton"
                Margin="5" 
                Height="35"                  
                Click="nextButton_Click"
                IsEnabled="{x:Bind ViewModel.EnableNext, Mode=OneWay}">
                <FontIcon Glyph="&#xE974;" />
            </Button>
            
        </StackPanel>

        <!-- Order Details Dialog -->
        <ContentDialog
            x:Name="OrderDetailsDialog"
            x:Uid="OrderListPage_OrderDetailsDialog"
            Title="Order Details"
            RequestedTheme="Default"
            CloseButtonText="Cancel"
            Width="400">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="Order ID:" FontWeight="Bold" x:Uid="OrderListPage_OrderID"/>
                    <TextBlock Text="{Binding ID}" Margin="0,0,0,10"/>
                    <TextBlock Text="Order Time:" FontWeight="Bold" x:Uid="OrderListPage_OrderTime"/>
                    <TextBlock Text="{Binding OrderTime}" Margin="0,0,0,10"/>
                    <TextBlock Text="SubTotal:" FontWeight="Bold" x:Uid="OrderListPage_SubTotal"/>
                    <TextBlock Text="{Binding SubTotal, Converter={StaticResource currencyConverter}}" Margin="0,0,0,10" />
                    <TextBlock Text="Discount:" FontWeight="Bold" x:Uid="OrderListPage_Discount"/>
                    <TextBlock Text="{Binding Discount, Converter={StaticResource currencyConverter}}" Margin="0,0,0,10"/>
                    <TextBlock Text="SaleTax:" FontWeight="Bold" x:Uid="OrderListPage_SaleTax"/>
                    <TextBlock Text="{Binding SaleTax, Converter={StaticResource currencyConverter}}" Margin="0,0,0,10"/>
                    <TextBlock Text="Total:" FontWeight="Bold" x:Uid="OrderListPage_Total"/>
                    <TextBlock Text="{Binding Total, Converter={StaticResource currencyConverter}}" Margin="0,0,0,10"/>
                    <TextBlock Text="Customer's Name:" FontWeight="Bold" x:Uid="OrderListPage_CusName"/>
                    <TextBlock Text="{Binding Customer.Name}" Margin="0,0,0,10"/>
                    <TextBlock Text="Customer's Phone:" FontWeight="Bold" x:Uid="OrderListPage_CusPhone"/>
                    <TextBlock Text="{Binding Customer.Phone}" Margin="0,0,0,10"/>
                    <TextBlock Text="Order Details:" FontWeight="Bold" Margin="0,10,0,10" x:Uid="OrderListPage_OrderDetails"/>
                    <ListView ItemsSource="{x:Bind ViewModel.ExtraOrderLists, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local3:ExtraOrderListViewModel">
                                <Grid Padding="0, 8, 0, 8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    
                                    <Border CornerRadius="6" 
                                                Grid.RowSpan="2" 
                                                Grid.Column="0"
                                                Margin="0, 0, 10, 0">
                                            <Image Source="{x:Bind Image}" Width="50" Height="50" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind Cosmetic.Name}" 
                                                   FontWeight="SemiBold" 
                                                   Margin="0,0,10,0"
                                                   Grid.Row="0"
                                                   Grid.Column="1"/>
                                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Quantity:" FontWeight="SemiBold" Margin="0,0,8,0" x:Uid="OrderListPage_Quantity"/>
                                        <TextBlock Text="{x:Bind OrderDetail.Quantity}" Margin="0,0,20,0"/>
                                        <TextBlock Text="Price:" FontWeight="SemiBold" Margin="0,0,8,0" x:Uid="OrderListPage_Price"/>
                                        <TextBlock Text="{x:Bind Cosmetic.Price, Converter={StaticResource currencyConverter}}" Margin="0,0,20,0"/>
                                        <TextBlock Text="Total:" FontWeight="SemiBold" Margin="0,0,8,0" x:Uid="OrderListPage_SubTotalDetail"/>
                                        <TextBlock Text="{x:Bind OrderDetail.SubTotal, Converter={StaticResource currencyConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
