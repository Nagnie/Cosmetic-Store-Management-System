<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cosmetic_Store_Management_System.Views.OrderListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="using:Cosmetic_Store_Management_System.Behaviors"
    xmlns:local="using:Cosmetic_Store_Management_System.Helpers"
    xmlns:local2="using:Cosmetic_Store_Management_System.Core.Models"
    xmlns:local3="using:Cosmetic_Store_Management_System.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <local:IntToCurrencyConverter x:Key="currencyConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bộ lọc -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBox x:Name="SearchBox" 
                         Width="250" 
                         PlaceholderText="Enter Customer's Name or Phone" 
                         Margin="5"
                         Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}"/>
                <Button 
                    Style="{StaticResource AccentButtonStyle}"
                    Background="{StaticResource AccentFillColorTertiaryBrush}"
                    Content="Search" Click="SearchButton_Click" Width="100" Margin="5"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Start Date:" VerticalAlignment="Center" Margin="5" />
                <DatePicker x:Name="StartDatePicker" 
                            Width="120" 
                            Margin="0,0,5,0" 
                            ToolTipService.ToolTip="Select start date"
                            SelectedDate="{Binding StartDateFilter, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="End Date:" VerticalAlignment="Center" Margin="5" />
                <DatePicker x:Name="EndDatePicker" 
                            Width="120" 
                            Margin="0,0,5,0" 
                            ToolTipService.ToolTip="Select end date" 
                            SelectedDate="{Binding EndDateFilter, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Background="{StaticResource AccentFillColorTertiaryBrush}"
                    Content="Filter" Click="FilterButton_Click" Width="100" Margin="5" />
                <Button 
                    Style="{StaticResource AccentButtonStyle}"
                    Background="{StaticResource AccentFillColorTertiaryBrush}"
                    Content="Clear Filter" 
                    Click="ClearFilterButton_Click"
                    Width="100" 
                    Margin="5" 
                    Command="{Binding ClearFiltersCommand}"/>
            </StackPanel>
        </StackPanel>


        <!-- GridView to display order summaries -->
        <GridView
            x:Name="OrderGridView"
            Grid.Row="1"
            Margin="10"
            ItemsSource="{x:Bind ViewModel.Orders}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="OrderGridView_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local2:Order">
                    <StackPanel CornerRadius="12" 
                        Width="300" 
                        Height="150" 
                        Padding="16, 16, 16, 16"
                        BorderBrush="{StaticResource AccentFillColorTertiaryBrush}"
                        BorderThickness="1">    
                        <StackPanel>
                            <TextBlock Text="{x:Bind ID}" FontSize="18" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Order Time:" FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind OrderTime}" FontSize="14" Foreground="Gray" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total:" FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind Total, Converter={StaticResource currencyConverter}}" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Customer's Name:" FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind Customer.Name}" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Customer's Phone:" FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind Customer.Phone}" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>


        <!-- Pagination controls -->
        <StackPanel 
            Grid.Row="2" 
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Bottom" 
            Margin="10">
            
            <TextBlock Name="infoTextBlock" 
                Text="{x:Bind ViewModel.Info, Mode=OneWay}" 
                Margin="0,10,5,0"/>

            <Button 
                Margin="5" 
                Height="35" 
                Name="previousButton" 
                Click="previousButton_Click"
                IsEnabled="{x:Bind ViewModel.EnablePrev, Mode=OneWay}">
                <FontIcon Glyph="&#xE973;" />
            </Button>
            
            <ComboBox ItemsSource="{x:Bind ViewModel.PageInfos, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.CurrentPageInfo, Mode=TwoWay}"
                SelectionChanged="pagesComboBox_SelectionChanged"
                Margin="5" Name="pagesComboBox" Width="80" Height="35">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Page}"/>/<Run Text="{Binding Total}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
            <Button Name="nextButton"
                Margin="5" 
                Height="35"                  
                Click="nextButton_Click"
                IsEnabled="{x:Bind ViewModel.EnableNext, Mode=OneWay}">
                <FontIcon Glyph="&#xE974;" />
            </Button>
            
        </StackPanel>

        <!-- Order Details Dialog -->
        <ContentDialog
            x:Name="OrderDetailsDialog"
            Title="Order Details"
            RequestedTheme="Default"
            CloseButtonText="Cancel">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="Order ID:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ID}" Margin="0,0,0,10"/>
                    <TextBlock Text="Order Time:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding OrderTime}" Margin="0,0,0,10"/>
                    <TextBlock Text="SubTotal:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SubTotal, Converter={StaticResource currencyConverter}}" Margin="0,0,0,10"/>
                    <TextBlock Text="Tax:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Tax, Converter={StaticResource currencyConverter}}" Margin="0,0,0,10"/>
                    <TextBlock Text="Discount:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Discount, Converter={StaticResource currencyConverter}}" Margin="0,0,0,10"/>
                    <TextBlock Text="SaleTax:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SaleTax, Converter={StaticResource currencyConverter}}" Margin="0,0,0,10"/>
                    <TextBlock Text="Total:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Total, Converter={StaticResource currencyConverter}}" Margin="0,0,0,10"/>
                    <TextBlock Text="Customer's Name:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Customer.Name}" Margin="0,0,0,10"/>
                    <TextBlock Text="Customer's Phone:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Customer.Phone}" Margin="0,0,0,10"/>
                    <TextBlock Text="Order Details:" FontWeight="Bold" Margin="0,10,0,5"/>
                    <ListView ItemsSource="{Binding Details}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local2:OrderDetail">
                                <StackPanel Orientation="Horizontal">
                                    <!--<Image Source="{x:Bind Image}" Width="50" Height="50"/>-->
                                    <TextBlock Text="{x:Bind Cosmetic.Name}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Text="{x:Bind Quantity}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{x:Bind Cosmetic.Price, Converter={StaticResource currencyConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
