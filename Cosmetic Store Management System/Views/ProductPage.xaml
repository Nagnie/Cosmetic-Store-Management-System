<Page
    x:Class="Cosmetic_Store_Management_System.Views.ProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:Cosmetic_Store_Management_System.Core.Models"
    xmlns:views="using:Cosmetic_Store_Management_System.Views"
    xmlns:behaviors="using:Cosmetic_Store_Management_System.Behaviors"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">
    
    <Page.Resources>
        
    </Page.Resources>

    <Grid x:Name="ContentArea">
       
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,80,0,0">

            <!-- Product Image -->
            <Border Height="350" Width="350" BorderBrush="lightcoral" BorderThickness="2" CornerRadius="10" Margin="0, 0, 0, 0">
                <Image Source="{Binding ImagePath}" Height="350" Width="350" HorizontalAlignment="Left" />
            </Border>
            

            <!-- Delete and Edit buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                <Button Content="Delete" Width="100" Margin="10" BorderBrush="Red" Foreground="Red" FontWeight="SemiBold"/>
                <Button Content="Edit" Width="100" Margin="10" BorderBrush="Navy" Foreground="Navy" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        <!-- Right Column (Product details) -->
        <StackPanel Grid.Column="1" Margin="0,70,0,0" HorizontalAlignment="Left">
            <TextBlock FontSize="30" FontWeight="Bold" Margin="25, 0, 0, 0" TextWrapping="Wrap">
                <Run Text="{Binding ProductName}"></Run>
            </TextBlock>
            <TextBlock FontSize="20" Margin="25,15,0,0">
                <Run Text="ID: " FontWeight="Bold" ></Run>
                <Run Text="{Binding ProductID}" FontWeight="Normal" ></Run>
            </TextBlock>
            <TextBlock FontSize="20" Margin="25,10,0,0">
                <Run Text="Category: " FontWeight="Bold" ></Run>
                <Run Text="{Binding Category}" FontWeight="Normal" ></Run>
            </TextBlock>
            <TextBlock FontSize="20" Margin="25,10,0,0">
                <Run Text="Brand Name: " FontWeight="Bold" ></Run>
                <Run Text="{Binding Manufacturer}" FontWeight="Normal" ></Run>
            </TextBlock>
            <TextBlock FontSize="20" Margin="25,10,0,0">
                <Run Text="Quantity: " FontWeight="Bold" />
                <Run Text="{Binding Quantity}" FontWeight="Normal" ></Run>
            </TextBlock>
            <TextBlock FontSize="20" Margin="25,10,0,0" TextWrapping="Wrap">
                <Run Text="Description: " FontWeight="Bold" />
                <Run Text="{Binding Description}" FontWeight="Normal" ></Run>
            </TextBlock>
            <TextBlock FontSize="20" Margin="25,10,0,0">
                <Run Text="Price: " FontWeight="Bold" />
                <Run Text="{Binding Price}" FontWeight="Normal" ></Run>
            </TextBlock>
            <TextBlock FontSize="20" Margin="25,10,0,0">
                <Run Text="Status: " FontWeight="Bold" />
                <Run Text="{Binding StockStatus}" FontWeight="Normal" ></Run>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
