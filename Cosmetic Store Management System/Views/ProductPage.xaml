<Page
    x:Class="Cosmetic_Store_Management_System.Views.ProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:Cosmetic_Store_Management_System.Core.Models"
    xmlns:views="using:Cosmetic_Store_Management_System.Views"
    xmlns:behaviors="using:Cosmetic_Store_Management_System.Behaviors"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">
    
    <Page.Resources>
        <DataTemplate x:Key="ItemTemplate" x:DataType="models:SampleProduct">

            <!-- Left Column (Image and Buttons) -->
            <Grid Margin="0, 30, 0, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>

                <!-- Product Image -->
                <StackPanel Grid.Column="0">
                    <Image Source="{Binding ImagePath}" Height="350" Width="350" HorizontalAlignment="Left" />

                    <!-- Delete and Edit buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                        <Button Content="Delete" Width="100" Margin="10" BorderBrush="Red" Foreground="Red" />
                        <Button Content="Edit" Width="100" Margin="10" BorderBrush="Red" Foreground="Red" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Column (Product details) -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock FontSize="30" FontWeight="Bold">
                        <Run Text="Product Name"></Run>
                        <Run Text="{Binding ProductName}"></Run>
                    </TextBlock>
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
                        <Run Text="ID: "></Run>
                        <Run Text="{Binding ProductID}"></Run>
                    </TextBlock>
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
                        <Run Text="Category"></Run>
                        <Run Text="{Binding Category}"></Run>
                    </TextBlock>
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
                        <Run Text="Brand Name"></Run>
                        <Run Text="{Binding Manufacturer}"></Run>
                    </TextBlock>
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
                        <Run Text="Quantity: "/>
                        <Run Text="{Binding Quantity}"></Run>
                    </TextBlock>
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
                        <Run Text="Description: "/>
                        <Run Text="{Binding Description}"></Run>
                    </TextBlock>
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
                        <Run Text="Price: "/>
                        <Run Text="{Binding Price}"></Run>
                    </TextBlock>
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
                        <Run Text="Status: "/>
                        <Run Text="{Binding StockStatus}"></Run>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="ContentArea">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="700" />
        </Grid.ColumnDefinitions>

        <!-- Product Image -->
        <StackPanel Grid.Column="0">
            <Image Source="{Binding ImagePath}" Height="350" Width="350" HorizontalAlignment="Left" />

            <!-- Delete and Edit buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                <Button Content="Delete" Width="100" Margin="10" BorderBrush="Red" Foreground="Red" />
                <Button Content="Edit" Width="100" Margin="10" BorderBrush="Red" Foreground="Red" />
            </StackPanel>
        </StackPanel>

        <!-- Right Column (Product details) -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock FontSize="30" FontWeight="Bold">
        <Run Text="Product Name"></Run>
        <Run Text="{Binding ProductName}"></Run>
            </TextBlock>
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
        <Run Text="ID: "></Run>
        <Run Text="{Binding ProductID}"></Run>
            </TextBlock>
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
        <Run Text="Category"></Run>
        <Run Text="{Binding Category}"></Run>
            </TextBlock>
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
        <Run Text="Brand Name"></Run>
        <Run Text="{Binding Manufacturer}"></Run>
            </TextBlock>
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
        <Run Text="Quantity: "/>
        <Run Text="{Binding Quantity}"></Run>
            </TextBlock>
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
        <Run Text="Description: "/>
        <Run Text="{Binding Description}"></Run>
            </TextBlock>
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
        <Run Text="Price: "/>
        <Run Text="{Binding Price}"></Run>
            </TextBlock>
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,10,0,0">
        <Run Text="Status: "/>
        <Run Text="{Binding StockStatus}"></Run>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
