<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cosmetic_Store_Management_System.Views.AddManufacturerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Name"
                   Grid.Row="0"
                   Grid.Column="0"
                   Margin="0, 0, 0, 12"
                   x:Uid="AddManufacturerPage_Name"/>
        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Margin="0, 0, 0, 12"
                 Text="{x:Bind ViewModel.Manufacturer.Name, Mode=TwoWay}"/>

        <TextBlock Text="Origin"
                   Grid.Column="0"
                   Grid.Row="1"
                   x:Uid="AddManufacturerPage_Origin"/>
        <TextBox Grid.Column="1"
                 Grid.Row="1"
                 ScrollViewer.HorizontalScrollMode="Enabled"
                 TextWrapping="Wrap"
                 Margin="0, 0, 0, 12"
                 Text="{x:Bind ViewModel.Manufacturer.Origin, Mode=TwoWay}"/>

        <TextBlock Text="Product Count"
                   Grid.Column="0"
                   Grid.Row="2"
                   x:Uid="AddManufacturerPage_ProductCount"/>
        <TextBox Grid.Column="1"
                 Grid.Row="2"
                 ScrollViewer.HorizontalScrollMode="Enabled"
                 TextWrapping="Wrap"
                 Height="120"
                 Text="{x:Bind ViewModel.Manufacturer.productCount, Mode=TwoWay}"/>

        <StackPanel Grid.Column="1"
                Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0, 16, 0, 0">
            <Button Content="Save"
                    Width="80"
                    Margin="0, 0, 12, 0"
                    Click="saveButton_Click"
                    x:Uid="AddManufacturerPage_SaveButton"/>
            <Button Content="Cancel"
                    Width="80"
                    Click="cancelButton_Click"
                    x:Uid="AddManufacturerPage_CancelButton"/>
        </StackPanel>
    </Grid>
</Page>
