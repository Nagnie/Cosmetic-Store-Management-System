<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Cosmetic_Store_Management_System.Views.OrderDetailsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:local1="using:Cosmetic_Store_Management_System.Core.Models" 
    xmlns:local2="using:Cosmetic_Store_Management_System.Helpers"
    xmlns:local3="using:Cosmetic_Store_Management_System.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local2:IntToCurrencyConverter x:Key="IntToCurrencyConverter"/>
    </UserControl.Resources>

    <GridView ItemsSource="{x:Bind ViewModel.ExtraOrderDetails}">
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="local3:ExtraOrderDetailsViewModel" >
                <Grid Padding="8, 8, 8, 8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="6" 
                                Grid.RowSpan="2" 
                                Grid.Column="0" 
                                Margin="0, 0, 12, 0">
                            <Image Source="{x:Bind Image}" Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock Text="{x:Bind Cosmetic.Name, Mode=OneWay}"
                               Grid.Row="0"
                               Grid.Column="1"/>

                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Button Width="20" 
                                    Height="20" 
                                    Padding="0" 
                                    VerticalAlignment="Center" 
                                    CornerRadius="20"
                                    Click="decreaseButton_Click">
                                    <FontIcon Glyph="&#xF8AB;" FontSize="10"/>
                                </Button>

                                <TextBlock Text="{x:Bind OrderDetail.Quantity, Mode=OneWay}"
                                       Width="40"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>

                                <Button Width="20" 
                                    Height="20" 
                                    Padding="0" 
                                    VerticalAlignment="Center" 
                                    CornerRadius="20"
                                    Click="increaseButton_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <FontIcon Glyph="&#xF8AA;" FontSize="10"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                   Text="{x:Bind OrderDetail.SubTotal, Mode=OneWay,
                                        Converter={StaticResource IntToCurrencyConverter}}"
                                   TextAlignment="End"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</UserControl>
