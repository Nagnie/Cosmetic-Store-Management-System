<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cosmetic_Store_Management_System.Views.EditCustomerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ID"
               Grid.Row="0"
               Grid.Column="0"
               Margin="0, 0, 0, 12"/>
        <TextBox Text="{x:Bind ViewModel.Customer.ID, Mode=TwoWay}"
             IsEnabled="False"
             Grid.Row="0"
             Grid.Column="1"
             Margin="0, 0, 0, 12"/>

        <TextBlock Text="Name"
               Grid.Row="1"
               Grid.Column="0"
               Margin="0, 0, 0, 12"
               x:Uid="EditCustomerPage_Name"/>
        <TextBox Text="{x:Bind ViewModel.Customer.Name, Mode=TwoWay}"
             Grid.Row="1"
             Grid.Column="1"
             Margin="0, 0, 0, 12"/>

        <TextBlock Text="Phone Number"
               Grid.Column="0"
               Grid.Row="2"
               Margin="0, 0, 0, 12"
               x:Uid="EditCustomerPage_Phone"/>
        <TextBox Text="{x:Bind ViewModel.Customer.Phone, Mode=TwoWay}"
             Grid.Column="1"
             Grid.Row="2"
             Margin="0, 0, 0, 12"
             ScrollViewer.HorizontalScrollMode="Enabled"
             TextWrapping="Wrap"/>

        <TextBlock Text="Point"
                  Grid.Column="0"
                  Grid.Row="3"
                   Margin="0, 0, 0, 12"
                  x:Uid="EditCustomerPage_Point"/>
        <TextBox Text="{x:Bind ViewModel.Customer.Point, Mode=TwoWay}"
                 Grid.Column="1"
                 Grid.Row="3"
                 Margin="0, 0, 0, 12"
                 IsEnabled="False"
                 ScrollViewer.HorizontalScrollMode="Enabled"
                 TextWrapping="Wrap"/>

        <TextBlock Text="Loyal"
                    Grid.Column="0"
                    Grid.Row="4"
                   Margin="0, 0, 0, 12"
              x:Uid="EditCustomerPage_Loyal"/>
        <FontIcon x:Name="LoyalIcon"
              Grid.Column="1"
              Grid.Row="4"
              Margin="0, 0, 0, 12"
              HorizontalAlignment="Left"
              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
              FontFamily="Segoe MDL2 Assets" 
              Glyph="{x:Bind ViewModel.Customer.Loyal}"/>


        <StackPanel Grid.Column="1"
                Grid.Row="5"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0, 16, 0, 0">
            <Button Content="Save"
                Width="80"
                Margin="0, 0, 12, 0"
                Click="saveButton_Click"
                Style="{ThemeResource AccentButtonStyle}"
                x:Uid="EditCustomerPage_SaveButton"/>
            <Button Content="Cancel"
                Width="80"
                Click="cancelButton_Click"
                x:Uid="EditCustomerPage_CancelButton"/>
        </StackPanel>
    </Grid>
</Page>
