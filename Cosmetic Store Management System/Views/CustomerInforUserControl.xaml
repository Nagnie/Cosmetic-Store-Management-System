<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Cosmetic_Store_Management_System.Views.CustomerInforUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0, 20, 0, 16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <TextBox PlaceholderText="Enter phone number"
                     Name="phoneNumberTextBox"
                     Header="Phone number"
                     Text="{x:Bind ViewModel.Customer.Phone, Mode=TwoWay}"
                     Grid.Column="0"/>

            <Button Name="searchButton"
                    Grid.Column="1" 
                    Margin="8, 0, 0, 0" 
                    VerticalAlignment="Bottom" 
                    Height="32" 
                    Padding="0, 0, 0, 0" 
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    BorderThickness="0"
                    Click="searchButton_Click">
                <FontIcon Glyph="&#xE721;" FontSize="12"/>
            </Button>

            <Button Name="saveCustomerButton"
                    Grid.Column="2" 
                    Margin="8, 0, 0, 0" 
                    VerticalAlignment="Bottom" 
                    Height="32" 
                    Padding="0, 0, 0, 0" 
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    BorderThickness="0"
                    Click="saveCustomerButton_Click">
                <FontIcon Glyph="&#xE74E;" FontSize="12"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Header="Name"
                     Name="nameTextBox"
                     PlaceholderText="Enter customer name"
                     Text="{x:Bind ViewModel.Customer.Name, Mode=TwoWay}"
                     Grid.Column="0"/>

            <TextBox Header="Point"
                     Text="{x:Bind ViewModel.Customer.Point, Mode=OneWay}"
                     Grid.Column="1"
                     Margin="8, 0, 0, 0"
                     IsEnabled="False"/>

        </Grid>
    </Grid>
</UserControl>
