<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cosmetic_Store_Management_System.Views.CustomerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Cosmetic_Store_Management_System.Core.Models"
    xmlns:views="using:Cosmetic_Store_Management_System.Views"
    xmlns:behaviors="using:Cosmetic_Store_Management_System.Behaviors" 
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="CustomerItemTemplate" x:DataType="models:Customer">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind ID}"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Name}"
                       Grid.Column="1"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Phone}"
                       Grid.Column="2"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Point}"
                       Grid.Column="3"
                       VerticalAlignment="Center"/>
                <FontIcon x:Name="LoyalIcon"
                      Grid.Column="4"
                      HorizontalAlignment="Left"
                      Foreground="{StaticResource AccentAAFillColorSecondaryBrush}"
                      FontFamily="Segoe MDL2 Assets" 
                      Glyph="{x:Bind Loyal}"/>
                <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Grid.Column="6">
                    <Button Margin="0, 0, 8, 0"
                        Name="editButton"
                        Click="editButton_Click">
                        <FontIcon Glyph="&#xE70F;" 
                              FontSize="12"/>
                    </Button>

                    <Button Name="deleteButton"
                        Click="deleteButton_Click">
                        <FontIcon Glyph="&#xE74D;" 
                              FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollMode="Enabled">
            <StackPanel Orientation="Vertical">
                <StackPanel HorizontalAlignment="Right"
            Margin="0, 0, 0, 12"
            Background="{StaticResource AccentAcrylicBackgroundFillColorDefaultBrush}"
            CornerRadius="4, 4, 4, 4">
                    <Button Click="addButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xF8AA;" 
                      FontSize="12"
                      Margin="0, 0, 12, 0"/>
                            <TextBlock x:Uid="ManufacturerPage_AddButtonText">Add</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Table header -->
                <Grid Padding="12, 12, 12, 12"
                      Background="{StaticResource AccentAcrylicBackgroundFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ID"
                           Grid.Column="0"
                           FontWeight="Bold"/>
                    <TextBlock Text="Name"
                           Grid.Column="1"
                           FontWeight="Bold"
                           x:Uid="CustomerPage_Name"/>
                    <TextBlock Text="Phone number"
                           FontWeight="Bold"
                           Grid.Column="2"
                           x:Uid="CustomerPage_PhoneNumber"/>
                    <TextBlock Text="Point"
                           FontWeight="Bold"
                           Grid.Column="3"
                           x:Uid="CustomerPage_Point"/>
                    <TextBlock Text="Loyal"
                           FontWeight="Bold"
                           Grid.Column="4"
                           x:Uid="CustomerPage_Loyal"/>
                    <TextBlock
                           FontWeight="Bold"
                           Grid.Column="5"
                           x:Uid="CustomerPage_Active"/>
                </Grid>
                <ListView
                  ItemTemplate="{StaticResource CustomerItemTemplate}"
                  ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 20, 0, 0">
                    <TextBlock Name="infoTextBlock" 
                       Text="{x:Bind ViewModel.Info, Mode=OneWay}" 
                       Margin="0,10,5,0"/>
                    <Button Margin="5" 
                            Height="35" 
                            Name="previousButton" 
                            Click="previousButton_Click" >
                        <FontIcon Glyph="&#xE973;" />
                    </Button>
                    <ComboBox ItemsSource="{x:Bind ViewModel.PageInfos, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedPageInfoItem, Mode=OneWay}"
                            SelectionChanged="pagesComboBox_SelectionChanged"
                            Margin="5" Name="pagesComboBox" Width="100" Height="35">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock >
                                    <Run Text="{Binding Page}"/>/<Run Text="{Binding Total}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Margin="5" 
                        Height="35" 
                        Name="nextButton" 
                        Click="nextButton_Click" >
                        <FontIcon Glyph="&#xE974;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
