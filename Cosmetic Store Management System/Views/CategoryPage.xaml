<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cosmetic_Store_Management_System.Views.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:models="using:Cosmetic_Store_Management_System.Core.Models"
    xmlns:views="using:Cosmetic_Store_Management_System.Views"
    xmlns:behaviors="using:Cosmetic_Store_Management_System.Behaviors" 
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="CategoryItemTemplate" x:DataType="models:Category">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind ID}"
                           Grid.Column="0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Name}"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ProductCount}"
                           Grid.Column="2"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Center"
                            Grid.Column="3">
                    <Button Margin="0, 0, 8, 0"
                            Name="editButton"
                            Click="editButton_Click">
                        <FontIcon Glyph="&#xE70F;" 
                                  FontSize="12"/>
                    </Button>
                    
                    <Button Name="deleteButton"
                            Click="deleteButton_Click">
                        <FontIcon Glyph="&#xE74D;" 
                                  FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="ContentArea">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" 
                        HorizontalAlignment="Center" 
                        Margin="0, 0, 40, 0">
                <Border CornerRadius="10" 
                        Padding="10" 
                        BorderThickness="2" 
                        BorderBrush="{StaticResource AccentAAFillColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center" 
                                Padding="20, 8, 20, 10">
                        <TextBlock 
                            HorizontalAlignment="Center" 
                            Text="Total Categories" 
                            x:Uid="CategoryPage_TotalCategories"
                            FontSize="20"
                            FontWeight="SemiBold"/>
                        <TextBlock 
                            Text="{x:Bind ViewModel.TotalItems, Mode=OneWay}" 
                            HorizontalAlignment="Center"
                            FontSize="40" 
                            FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0, 0, 40, 0">
                <TextBlock 
                    Text="Add Category" 
                    FontSize="22"
                    FontWeight="SemiBold"
                    Margin="0, 20, 0, 24"
                    x:Uid="CategoryPage_AddLabel"/>
                <TextBlock 
                    Text="Enter Name"
                    Margin="0, 0, 0, 12"
                    x:Uid="CategoryPage_NameInputHeader"/>
                <TextBox Name="nameInput"
                         x:Uid="CategoryPage_NameInput"/>
                <Button 
                    Content="Save"
                    x:Name="saveButton"
                    Width="80" HorizontalAlignment="Right"
                    Margin="0, 24, 0, 0"
                    Style="{ThemeResource AccentButtonStyle}"
                    x:Uid="CategoryPage_SaveButton"
                    Click="addCategoryButton_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Top">
                <!-- Table header -->
                <StackPanel>
                    <Grid Padding="12, 12, 12, 12"   
                          Background="{ThemeResource AccentAcrylicBackgroundFillColorBaseBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ID"
                                   Grid.Column="0"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Name"
                                   Grid.Column="1"
                                   FontWeight="Bold"
                                   x:Uid="CategoryPage_Name"/>
                        <TextBlock Text="Product Count"
                                   FontWeight="Bold"
                                   Grid.Column="2"
                                   x:Uid="CategoryPage_ProductCount"/>
                        <TextBlock Text="Active"
                                   FontWeight="Bold"
                                   Grid.Column="3"
                                   x:Uid="CategoryPage_Active"/>
                    </Grid>

                    <ListView x:Uid="CategoryItemList"
                              ItemTemplate="{StaticResource CategoryItemTemplate}"
                              ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 20, 0, 0">
                        <TextBlock Name="infoTextBlock" 
                                   Text="{x:Bind ViewModel.Info, Mode=OneWay}" 
                                   Margin="0,10,5,0"/>
                        <Button Margin="5"  
                                Height="35" 
                                Name="previousButton" 
                                Click="previousButton_Click"
                                x:Uid="CategoryPage_PrevButton">
                            <FontIcon Glyph="&#xE973;" />
                        </Button>
                        <ComboBox ItemsSource="{x:Bind ViewModel.PageInfos, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedPageInfoItem, Mode=OneWay}"
                                SelectionChanged="pagesComboBox_SelectionChanged"
                                Margin="5" Name="pagesComboBox" Width="80" Height="35">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock >
                                        <Run Text="{Binding Page}"/>/<Run Text="{Binding Total}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Margin="5" 
                                Height="35" 
                                Name="nextButton" 
                                Click="nextButton_Click"
                                x:Uid="CategoryPage_NextButton">
                            <FontIcon Glyph="&#xE974;" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Page>
