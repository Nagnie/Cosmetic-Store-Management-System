<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cosmetic_Store_Management_System.Views.AddCosmeticPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="using:Cosmetic_Store_Management_System.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <FontFamily x:Key="DongleBold">/Assets/Font/Dongle/Dongle-Bold.ttf#Dongle Bold</FontFamily>
        <DataTemplate x:Key="ManufacturerItemTemplate" x:DataType="models:Manufacturer">
            <TextBlock Text="{x:Bind Name}"/>
        </DataTemplate>

        <DataTemplate x:Key="CategoryItemTemplate" x:DataType="models:Category">
            <TextBlock Text="{x:Bind Name}"/>
        </DataTemplate>
    </Page.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="460"/>
                </Grid.ColumnDefinitions>
                <!--ID, name, category_id, manufacturer_id, quantity, description, image-->

                <TextBlock x:Uid="AddCosmeticPage_Name"
                            Text="Name"
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0, 0, 0, 10"/>
                <TextBox Name="name"
                         Text="{x:Bind ViewModel.Cosmetic.Name, Mode=TwoWay}"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0, 0, 0, 10"
                         TextWrapping="Wrap"/>

                <TextBlock Text="Category"
                           Grid.Row="1"
                           Grid.Column="0"
                           Margin="0, 0, 0, 10"
                           x:Uid="AddCosmeticPage_Category"
                          />
                <ComboBox x:Name="categoryComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0, 0, 0, 10"
                          Width="460"
                          ItemsSource="{x:Bind ViewModel.Categories}"
                          ItemTemplate="{StaticResource CategoryItemTemplate}">
                    
                </ComboBox>

                <TextBlock Text="Manufacturer"
                           Grid.Row="2"
                           Grid.Column="0"
                           Margin="0, 0, 0, 10"
                           x:Uid="AddCosmeticPage_Manufacturer"
                           />
                <ComboBox x:Name="manufacturerComboBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          Margin="0, 0, 0, 10"
                          Width="460"
                          ItemsSource="{x:Bind ViewModel.Manufacturers}"
                          ItemTemplate="{StaticResource ManufacturerItemTemplate}"/>

                <TextBlock Text="Quantity"
                           Grid.Row="3"
                           Grid.Column="0"
                           Margin="0, 0, 0, 10"
                           x:Uid="AddCosmeticPage_Quantity"
                          />
                <TextBox Name="quantity"
                         Text="{x:Bind ViewModel.quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Row="3"
                         Grid.Column="1"
                         Margin="0, 0, 0, 10"/>

                <TextBlock Text="Price"
                           Grid.Row="4"
                           Grid.Column="0"
                           Margin="0, 0, 0, 10"
                           x:Uid="AddCosmeticPage_Price"
                           />

                <TextBox Name="price"
                         Text="{x:Bind ViewModel.price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Row="4"
                         Grid.Column="1"
                         Margin="0, 0, 0, 10"/>

                <TextBlock Text="Image"
                           Grid.Row="5"
                           Grid.Column="0"
                           Margin="0, 0, 0, 10" 
                           x:Uid="AddCosmeticPage_Image"/>
                <StackPanel Orientation="Horizontal"
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="0, 0, 0, 10">
                    <Button x:Name="PickAPhotoButton" 
                        Content="Open a picture"
                        Click="PickAPhotoButton_Click" />
                    <TextBlock 
                        Name="PickAPhotoOutputTextBlock" 
                        Padding="15,5,0,0"
                        TextWrapping="Wrap"/>
                </StackPanel>
                

                <TextBlock Text="Description"
                           Grid.Row="6"
                           Grid.Column="0"
                           Margin="0, 0, 0, 10"
                           x:Uid="AddCosmeticPage_Description"
                           />
                <TextBox Name="description"
                         Text="{x:Bind ViewModel.Cosmetic.Description, Mode=TwoWay}"
                         Grid.Row="6"
                         Grid.Column="1"
                         Margin="0, 0, 0, 10"
                         TextWrapping="Wrap"
                         Height="160"/>
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="120, 20, 0, 0">
            <Button Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    Background="{StaticResource AccentFillColorTertiaryBrush}"
                    Click="saveButton_Click"
                    Margin="0, 0, 20, 0"
                    Width="80"
                    x:Uid="AddCosmeticPage_SaveButton"
                    x:Name="saveButton"/>

            <Button Content="Cancel"
                    Click="cancelButton_Click"
                    Width="80"
                    x:Uid="AddCosmeticPage_CancelButton"
                    x:Name="cancelButton"/>
        </StackPanel>
    </StackPanel>
</Page>
