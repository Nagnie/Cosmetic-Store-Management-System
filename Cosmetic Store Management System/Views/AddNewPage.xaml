<Page
    x:Class="Cosmetic_Store_Management_System.Views.AddNewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cosmetic_Store_Management_System.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="using:Cosmetic_Store_Management_System.Behaviors"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ContentArea" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Phía bên trái: Form nhập thông tin -->
            <StackPanel Orientation="Vertical" Grid.Column="0" Spacing="10" HorizontalAlignment="Left">
                <TextBlock Text="Product's Name" 
                           FontSize="16" 
                           FontWeight="Bold"
                           x:Uid="AddNewPage_ProductName"/>
                
                <TextBox x:Name="ProductNameInput" 
                         PlaceholderText="Enter product name" 
                         Width="365" 
                         Margin="0,0,60,0"
                         x:Uid="AddNewPage_ProductNameInput"/>

                <TextBlock Text="ID" FontSize="16" FontWeight="Bold" />
                <TextBox x:Name="ProductIDInput" PlaceholderText="Enter product ID" Width="365" Margin="0,0,60,0"/>

                <TextBlock Text="Category" FontSize="16" FontWeight="Bold" />
                <TextBox x:Name="CategoryInput" PlaceholderText="Enter category" Width="365" Margin="0,0,60,0"/>

                <TextBlock Text="Brand Name" FontSize="16" FontWeight="Bold" />
                <TextBox x:Name="BrandNameInput" PlaceholderText="Enter brand name" Width="365" Margin="0,0,60,0"/>

                <TextBlock Text="Quantity" FontSize="16" FontWeight="Bold" />
                <TextBox x:Name="QuantityInput" PlaceholderText="Enter quantity" Width="365" Margin="0,0,60,0"/>

                <TextBlock Text="Price" FontSize="16" FontWeight="Bold" />
                <TextBox x:Name="PriceInput" PlaceholderText="Enter price" Width="365" Margin="0,0,60,0"/>

                <TextBlock Text="Image Link" FontSize="16" FontWeight="Bold" />
                <TextBox x:Name="ImageLinkInput" PlaceholderText="Enter image link" Width="365" Margin="0,0,60,0" TextChanged="ImageLinkInput_TextChanged"/>

                <!--<TextBlock Text="Image" FontSize="16" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Choose Image" Click="ChooseImageButton_Click" Width="150" />
                    <TextBlock x:Name="ImagePathTextBlock" Text="No file selected" Width="200" TextWrapping="Wrap"/>
                </StackPanel>-->


                <TextBlock Text="Description" FontSize="16" FontWeight="Bold" />
                <TextBox x:Name="DescriptionInput" PlaceholderText="Enter description" Width="365" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,60,0"/>

                <!-- Button Container -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button 
                        Content="Cancel"
                        VerticalAlignment="Top"
                        FontSize="16"
                        Background="Transparent"
                        MinHeight="40"
                        MinWidth="80"
                        Margin="0,0,30,0"
                        Click="CancelButton_Click">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border                             
                                                BorderBrush="Gray"
                                                BorderThickness="2"
                                                CornerRadius="5">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ContentPresenter 
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button 
                        Content="OK"
                        VerticalAlignment="Top"
                        FontSize="16"
                        Background="Transparent"
                        MinHeight="40"
                        MinWidth="80"
                        Click="OKButton_Click">
                        

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border                             
                                                BorderBrush="Gray"
                                                BorderThickness="2"
                                                CornerRadius="5">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ContentPresenter 
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Phía bên phải: Hiển thị thông tin đã nhập -->
            <StackPanel Grid.Column="1" Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Product's Name" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{x:Bind ProductNameInput.Text, Mode=OneWay}" Grid.Column="1" Width="250" HorizontalAlignment="Left"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ID" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{x:Bind ProductIDInput.Text, Mode=OneWay}" Grid.Column="1" Width="250" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Category" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{x:Bind CategoryInput.Text, Mode=OneWay}" Grid.Column="1" Width="250" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Brand Name" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{x:Bind BrandNameInput.Text, Mode=OneWay}" Grid.Column="1" Width="250" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Quantity" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{x:Bind QuantityInput.Text, Mode=OneWay}" Grid.Column="1" Width="250" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Price" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{x:Bind PriceInput.Text, Mode=OneWay}" Grid.Column="1" Width="250" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Image Preview" FontSize="16" FontWeight="Bold" />
                    <Image x:Name="ImagePreview" Width="350" Height="250" Stretch="Uniform" Grid.Column="1" HorizontalAlignment="Left" />


                    <!--<TextBlock Text="Image" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{x:Bind ImagePathTextBlock.Text, Mode=OneWay}" Grid.Column="1" Width="250" />-->
                </Grid>

                <TextBlock Text="Description" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="{x:Bind DescriptionInput.Text, Mode=OneWay}" Width="250" TextWrapping="Wrap" Margin="0,0,160,0"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
